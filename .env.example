# Salin file ini jadi .env lalu isi nilainya. JANGAN commit file .env.

APP_ENV=development

# Kredensial container Postgres (dibaca docker-compose.yml)
# WAJIB diganti sebelum deploy ke VPS — jangan pernah pakai nilai contoh ini
POSTGRES_USER=jobmatch
POSTGRES_PASSWORD=jobmatch
POSTGRES_DB=jobmatch

# Dipakai aplikasi (job_match_api) untuk connect ke Postgres di atas
# Kalau ganti user/password di atas, sesuaikan juga di sini
DATABASE_URL=postgresql+psycopg://jobmatch:jobmatch@localhost:5433/jobmatch

# Jooble — WAJIB pakai host id.jooble.org, yang tanpa "id." balas 403
JOOBLE_API_KEY=
JOOBLE_BASE_URL=https://id.jooble.org/api

# LLM
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Telegram — token dari @BotFather
TELEGRAM_BOT_TOKEN=

JWT_SECRET=
